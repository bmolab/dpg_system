                "1": {
                    "init": "comment t.minimum - the smaller of two tensors, element by element",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 721,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "t.minimum - the smaller of two tensors, element by element",
                            "value_type": "str"
                        },
                        "1": {
                            "name": "font size",
