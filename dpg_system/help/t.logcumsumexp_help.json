                "1": {
                    "init": "comment t.logcumsumexp - a running total in the log domain",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 623,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "t.logcumsumexp - a running total in the log domain",
                            "value_type": "str"
                        },
                        "1": {
                            "name": "font size",
