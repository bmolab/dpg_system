            "id": 866,
            "name": "np.distance_from_target_help",
            "path": "/private/tmp/claude-501/-Users-drokeby-dpg-system/875feb0e-f6f2-4382-b340-bae60e82ad51/scratchpad/dist/out/np.distance_from_target_help.json",
