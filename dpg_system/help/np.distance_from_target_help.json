                "1": {
                    "init": "comment np.distance_from_target - how far from a stored spot",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 624,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "np.distance_from_target - how far from a stored spot",
                            "value_type": "str"
                        },
                        "1": {
                            "name": "font size",
