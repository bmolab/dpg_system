                "1": {
                    "init": "comment t.diag - a matrix's diagonal, or a matrix from a vector",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 684,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
