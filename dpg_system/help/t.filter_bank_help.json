                "1": {
                    "init": "comment t.filter_bank - split streams into frequency bands",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 623,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "t.filter_bank - split streams into frequency bands",
                            "value_type": "str"
                        },
                        "1": {
