                "1": {
                    "init": "comment np.concatenate - join arrays end to end",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 488,
                    "height": 42,
                    "visibility": "show_all",
