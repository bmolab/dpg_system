                    "width": 758,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "np.proximity_to_target - closeness to several targets, 1 to 0",
