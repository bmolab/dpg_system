                "1": {
                    "init": "comment t.permute - put the axes in a new order",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 488,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "t.permute - put the axes in a new order",
                            "value_type": "str"
                        },
                        "1": {
                            "name": "font size",
