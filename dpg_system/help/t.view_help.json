                "1": {
                    "init": "comment t.view - a new shape without copying, or not at all",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 635,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
