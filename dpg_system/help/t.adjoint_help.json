                "1": {
                    "init": "comment t.adjoint - swap the last two axes (and conjugate)",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 623,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "t.adjoint - swap the last two axes (and conjugate)",
                            "value_type": "str"
                        },
                        "1": {
                            "name": "font size",
                            "value": "48",
                            "value_type": "str"
