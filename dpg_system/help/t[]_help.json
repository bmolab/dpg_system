                "1": {
                    "init": "comment t[] - take part of a tensor by index",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 451,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "t[] - take part of a tensor by index",
                            "value_type": "str"
                        },
                        "1": {
