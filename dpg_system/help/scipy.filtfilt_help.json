                "1": {
                    "init": "comment scipy.filtfilt - filter a recording without any delay",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 660,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "scipy.filtfilt - filter a recording without any delay",
                            "value_type": "str"
                        },
                        "1": {
                            "name": "font size",
