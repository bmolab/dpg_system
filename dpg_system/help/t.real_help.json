                "1": {
                    "init": "comment t.real - the real part of a complex tensor",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 525,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "t.real - the real part of a complex tensor",
                            "value_type": "str"
                        },
                        "1": {
