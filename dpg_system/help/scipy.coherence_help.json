                "1": {
                    "init": "comment scipy.coherence - which rhythms two signals share",
                    "name": "comment",
                    "id": 274,
                    "position_x": 24,
                    "position_y": -4,
                    "width": 611,
                    "height": 42,
                    "visibility": "show_all",
                    "draggable": true,
                    "presentation_state": "show_all",
                    "properties": {
                        "0": {
                            "name": "text",
                            "value": "scipy.coherence - which rhythms two signals share",
                            "value_type": "str"
                        },
                        "1": {
                            "name": "font size",
